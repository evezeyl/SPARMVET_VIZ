# ============================================================
# SPARMVET_VIZ .aiignore
# Controls what the AI indexer / context loader excludes.
# The AI can still explicitly read any file with the Read tool.
# ============================================================

# --- Personal developer workspace ---
EVE_WORK/
presentation/
.claude/conversations/

# --- Data files (rows of data add no value to AI context) ---
*.csv
*.tsv
*.xlsx
*.ods
*.parquet

# --- Build & generated artifacts ---
**/*.egg-info/
**/__pycache__/
**/*.pyc
.venv/
_book/
dist/
build/
node_modules/
docs/_site/
docs/_book/
docs/_freeze/
docs/.quarto/
docs/**/libs/*
docs/**/*.html
site_libs/

# --- Temporary workspaces (agent scratch, not source) ---
tmp/
tmpAI/

# --- IDE user-specific state ---
.vscode/bookmarks.json
.vscode/favorites/
.vscode/settings.json

# --- OS / file manager metadata ---
.directory
.DS_Store

# --- Secrets ---
.env
.env.*
*.key
*.pem
secrets/
apikeys.txt

# --- Agent conversation & session state (ephemeral, no index value) ---
.claude/logs/sessions/
.claude/logs/handoffs/archive/

# --- Large binary / archive files ---
*.tar.gz
*.zip
*.png
*.jpg
*.jpeg
*.svg
*.pdf

# --- GitHub / tooling metadata (no code value) ---
.github/
.gitignore
.aiignore
.clinerules
.dockerignore

# --- Lock / temp files ---
*.~lock*

# --- Misc IDE files ---
*.code-workspace
.idea/
.history/
